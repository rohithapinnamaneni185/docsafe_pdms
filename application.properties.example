# ====================================================================
# Personal Document Management System (PDMS) Configuration Example
# Copy this file to src/main/resources/application.properties and set your credentials
# ====================================================================

# Application Server Port
server.port=8080

# --------------------------------------------------------------------
# MySQL Database Configuration
# --------------------------------------------------------------------
# Replace 'localhost:3306', 'personal_document_db', 'your_username', and 'your_password'
# with your actual MySQL database credentials.
spring.datasource.url=jdbc:mysql://localhost:3306/personal_document_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --------------------------------------------------------------------
# JPA / Hibernate Settings
# --------------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# --------------------------------------------------------------------
# Document Upload Directory and Maximum Size Limits
# --------------------------------------------------------------------
# Directory path on the server where uploaded document images are stored
app.upload.dir=uploads

# Maximum allowable upload size for individual files and multipart requests
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=15MB
